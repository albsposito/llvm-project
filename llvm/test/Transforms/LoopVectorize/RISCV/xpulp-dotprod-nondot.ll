  %add.lcssa = phi i16 [ %add, %for.body ]
  br label %for.cond.cleanup

for.cond.cleanup:                                 ; preds = %for.cond.cleanup.loopexit, %entry
  %c.0.lcssa = phi i16 [ 0, %entry ], [ %add.lcssa, %for.cond.cleanup.loopexit ]
  ret i16 %c.0.lcssa

for.body:                                         ; preds = %for.body.preheader, %for.body
  %i.06 = phi i32 [ %inc, %for.body ], [ 0, %for.body.preheader ]
  %c.05 = phi i16 [ %add, %for.body ], [ 0, %for.body.preheader ]
  %arrayidx = getelementptr inbounds nuw i16, ptr %a, i32 %i.06
  %0 = load i16, ptr %arrayidx, align 2
  %cmp1 = icmp sgt i16 %0, 5
  %conv2 = zext i1 %cmp1 to i16
  %add = add i16 %c.05, %conv2
  %inc = add nuw nsw i32 %i.06, 1
  %exitcond.not = icmp eq i32 %inc, %n
  br i1 %exitcond.not, label %for.cond.cleanup.loopexit, label %for.body
}
