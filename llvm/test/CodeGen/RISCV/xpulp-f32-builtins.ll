; RUN: llc -mtriple=riscv32 -mattr=+f,+xpulpv -verify-machineinstrs < %s \
; RUN:   | FileCheck %s --check-prefix=F

; Guards 20/F036: the GAP9 f32 scalar builtins (__builtin_pulp_f32max, ...)
; are one standard F/Zfinx instruction each, as in GAP9 GCC: fmax.s, fmin.s,
; fabs.s, fsqrt.s, and fcvt.w.s with the fixed rounding mode rmm (rintsf2),
; rdn (rdownsf2) and rup (rupsf2). The last three functions check the
; constant folding: f32max/f32min are IEEE 754-2019 maximumNumber /
; minimumNumber, so -0.0 < +0.0 and a NaN operand yields the other operand.

declare float @llvm.riscv.pulp.f32max(float, float)
declare float @llvm.riscv.pulp.f32min(float, float)
declare float @llvm.riscv.pulp.f32abs(float)
declare float @llvm.riscv.pulp.f32sqrt(float)
declare i32 @llvm.riscv.pulp.rintsf2(float)
declare i32 @llvm.riscv.pulp.rdownsf2(float)
declare i32 @llvm.riscv.pulp.rupsf2(float)

define float @f32max(float %a, float %b) {
; ZFINX-LABEL: f32max:
; ZFINX:       # %bb.0:
; ZFINX-NEXT:    fmax.s a0, a0, a1
; ZFINX-NEXT:    ret
;
; F-LABEL: f32max:
; F:       # %bb.0:
; F-NEXT:    fmax.s fa0, fa0, fa1
; F-NEXT:    ret
  %r = call float @llvm.riscv.pulp.f32max(float %a, float %b)
  ret float %r
}

