; GAP9 packed half precision compares (task 20/F060). vfeq/vfne/vflt/vfle/
; vfgt/vfge write 0 or 1 per 16-bit lane on GAP9 silicon (B99); a v2i16
; boolean lane is 0 or -1, so the result is negated (pv.sub.h from zero),
; or decremented (pv.add.sci.h -1) for the inverse condition. Every compare,
; vfne included, is false for a NaN lane, so the unordered predicates (UNE,
; UNO, UGE, ...) are inverses of ordered ones.

define <2 x i16> @fcmp_oeq_h(<2 x half> %a, <2 x half> %b) {
; CHECK-LABEL: fcmp_oeq_h:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vfeq.h a0, a0, a1
; CHECK-NEXT:    pv.sub.h a0, zero, a0
; CHECK-NEXT:    ret
  %c = fcmp oeq <2 x half> %a, %b
  %r = sext <2 x i1> %c to <2 x i16>
  ret <2 x i16> %r
}

