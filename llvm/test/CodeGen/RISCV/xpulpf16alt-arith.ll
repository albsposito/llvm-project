; GAP9 float16alt (bfloat16 in a GPR, Xpulpf16alt): arithmetic is one .ah
; instruction (task 20/F053); nothing goes through float or __truncsfbf2.
; fneg/fabs/copysign only move the sign bit, so NaN payloads (signalling
; ones included) are kept.

define bfloat @fadd(bfloat %a, bfloat %b) nounwind {
; CHECK-LABEL: fadd:
; CHECK:       # %bb.0:
; CHECK-NEXT:    fadd.ah a0, a0, a1
; CHECK-NEXT:    ret
  %r = fadd bfloat %a, %b
  ret bfloat %r
}

