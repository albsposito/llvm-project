; The sign bit of an sNaN bit pattern is flipped and the payload kept.
define i16 @fneg_snan_bits() nounwind {
; CHECK-LABEL: fneg_snan_bits:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lui a0, 16
; CHECK-NEXT:    addi a0, a0, -127
; CHECK-NEXT:    ret
  %x = bitcast i16 32641 to bfloat     ; 0x7f81, a signalling NaN
  %n = fneg bfloat %x
  %r = bitcast bfloat %n to i16
  ret i16 %r
}

define i16 @fabs_bits(i16 %bits) nounwind {
  %x = bitcast i16 %bits to bfloat
  %n = call bfloat @llvm.fabs.bf16(bfloat %x)
  %r = bitcast bfloat %n to i16
  ret i16 %r
}

