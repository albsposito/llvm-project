; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=riscv32 -mattr=+xpulpv -verify-machineinstrs < %s | FileCheck %s
; RUN: llc -mtriple=riscv32 -mattr=+m,+c,+xgap,+xpulpv,+xpulpfvec,+xpulpf16alt,+zfinx,+zhinx,+zhinxmin \
; RUN:   -verify-machineinstrs < %s | FileCheck %s

; 20/F054 (B157 C2): de-interleaving a vector wider than one PULP packed register made the DAG
; combiner ask isExtractSubvectorCheap, which read the RVV VLEN and asserted without V
; ("Tried to get vector length without Zve or V extension support!"). Without V it now answers
; false and the lanes are rebuilt with pv.shuffle2 / pv.pack.

define <2 x i16> @deint_v4i16(ptr %p) nounwind {
; CHECK-LABEL: deint_v4i16:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lhu a1, 4(a0)
; CHECK-NEXT:    lhu a2, 0(a0)
; CHECK-NEXT:    lhu a3, 2(a0)
; CHECK-NEXT:    lhu a0, 6(a0)
; CHECK-NEXT:    lui a4, 32
; CHECK-NEXT:    pv.shuffle2.h a2, a1, a4
; CHECK-NEXT:    lui a1, 48
; CHECK-NEXT:    slli a0, a0, 16
; CHECK-NEXT:    slli a3, a3, 16
; CHECK-NEXT:    addi a1, a1, 1
; CHECK-NEXT:    pv.shuffle2.h a3, a0, a1
; CHECK-NEXT:    pv.add.h a0, a2, a3
; CHECK-NEXT:    ret
  %w = load <4 x i16>, ptr %p, align 2
  %e = shufflevector <4 x i16> %w, <4 x i16> poison, <2 x i32> <i32 0, i32 2>
  %o = shufflevector <4 x i16> %w, <4 x i16> poison, <2 x i32> <i32 1, i32 3>
  %r = add <2 x i16> %e, %o
  ret <2 x i16> %r
}

define <4 x i8> @deint_v8i8(ptr %p) nounwind {
; CHECK-LABEL: deint_v8i8:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lw a1, 0(a0)
; CHECK-NEXT:    lw a0, 4(a0)
; CHECK-NEXT:    lui a2, 24640
; CHECK-NEXT:    addi a2, a2, 512
; CHECK-NEXT:    mv a3, a1
; CHECK-NEXT:    pv.shuffle2.b a3, a0, a2
; CHECK-NEXT:    lui a2, 28752
; CHECK-NEXT:    addi a2, a2, 769
; CHECK-NEXT:    pv.shuffle2.b a1, a0, a2
; CHECK-NEXT:    pv.add.b a0, a3, a1
; CHECK-NEXT:    ret
  %w = load <8 x i8>, ptr %p, align 4
  %e = shufflevector <8 x i8> %w, <8 x i8> poison, <4 x i32> <i32 0, i32 2, i32 4, i32 6>
  %o = shufflevector <8 x i8> %w, <8 x i8> poison, <4 x i32> <i32 1, i32 3, i32 5, i32 7>
  %r = add <4 x i8> %e, %o
  ret <4 x i8> %r
}
