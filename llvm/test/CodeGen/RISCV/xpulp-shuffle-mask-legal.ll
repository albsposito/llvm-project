; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=riscv32 -mattr=+xpulpv -verify-machineinstrs < %s | FileCheck %s
; RUN: llc -mtriple=riscv32 -mattr=+m,+c,+xgap,+xpulpv,+xpulpfvec,+xpulpf16alt,+zfinx,+zhinx,+zhinxmin \
; RUN:   -verify-machineinstrs < %s | FileCheck %s

; 20/F054 (B157 C3): interleaving two PULP packed registers into a wider vector made the DAG
; combiner ask isShuffleMaskLegal for v2i16 / v4i8, which reached the RVV-only
; isInterleaveShuffle and asserted in getELen() without V ("Expected V extension"). Without V
; it now answers false and the shuffle is expanded lane by lane.

define void @intl_v2i16(ptr %p, <2 x i16> %a, <2 x i16> %b) nounwind {
; CHECK-LABEL: intl_v2i16:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pv.shuffle.sci.h a3, a2, 1
; CHECK-NEXT:    pv.shuffle.sci.h a4, a1, 3
; CHECK-NEXT:    srli a2, a2, 16
; CHECK-NEXT:    srli a3, a3, 16
; CHECK-NEXT:    sh a1, 0(a0)
; CHECK-NEXT:    sh a3, 2(a0)
; CHECK-NEXT:    sh a4, 4(a0)
; CHECK-NEXT:    sh a2, 6(a0)
; CHECK-NEXT:    ret
  %s = shufflevector <2 x i16> %a, <2 x i16> %b, <4 x i32> <i32 0, i32 2, i32 1, i32 3>
  store <4 x i16> %s, ptr %p, align 2
  ret void
}

define void @intl_v4i8(ptr %p, <4 x i8> %a, <4 x i8> %b) nounwind {
; CHECK-LABEL: intl_v4i8:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lui a3, 20496
; CHECK-NEXT:    mv a4, a1
; CHECK-NEXT:    addi a3, a3, 1024
; CHECK-NEXT:    pv.shuffle2.b a4, a2, a3
; CHECK-NEXT:    lui a3, 28720
; CHECK-NEXT:    addi a3, a3, 1538
; CHECK-NEXT:    pv.shuffle2.b a1, a2, a3
; CHECK-NEXT:    sw a4, 0(a0)
; CHECK-NEXT:    sw a1, 4(a0)
; CHECK-NEXT:    ret
  %s = shufflevector <4 x i8> %a, <4 x i8> %b, <8 x i32> <i32 0, i32 4, i32 1, i32 5, i32 2, i32 6, i32 3, i32 7>
  store <8 x i8> %s, ptr %p, align 4
  ret void
}
