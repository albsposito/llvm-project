  %av = shufflevector <2 x half> %ai, <2 x half> poison, <2 x i32> zeroinitializer
  br label %loop
loop:
  %i = phi i32 [ 0, %loop.ph ], [ %inc, %loop ]
  %px = getelementptr inbounds <2 x half>, ptr %x, i32 %i
  %py = getelementptr inbounds <2 x half>, ptr %y, i32 %i
