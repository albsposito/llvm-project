; CHECK-NEXT:    srli a4, a4, 2
; CHECK-NEXT:    pv.pack.h a2, a2, a2
; CHECK-NEXT:    .p2align 2
; CHECK-NEXT:  # %bb.5: # %loop.ph
; CHECK-NEXT:    lp.setup x0, a4, .LBB4_4
; CHECK-NEXT:  .LBB4_2: # Block address taken
; CHECK-NEXT:    # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    # Label of block must be emitted
; CHECK-NEXT:    p.lw a4, 4(a1!)
; CHECK-NEXT:    lw a5, 0(a0)
; CHECK-NEXT:    vfmac.h a5, a2, a4
; CHECK-NEXT:  .LBB4_4: # in Loop: Header=BB4_2 Depth=1
; CHECK-NEXT:    # Label of block must be emitted
; CHECK-NEXT:    p.sw a5, 4(a0!)
; CHECK-NEXT:  .LBB4_3: # %exit
; CHECK-NEXT:    ret
; CHECK-NEXT:  .Ltmp0: # Address of block that was removed by CodeGen
entry:
  %cmp = icmp sgt i32 %n, 0
  br i1 %cmp, label %loop.ph, label %exit
loop.ph:
