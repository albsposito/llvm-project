; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py
; RUN: llc -mtriple=riscv32 -mattr=+xpulpv -verify-machineinstrs < %s | FileCheck %s
; RUN: llc -mtriple=riscv32 -mattr=+m,+c,+xgap,+xpulpv,+xpulpfvec,+xpulpf16alt,+zfinx,+zhinx,+zhinxmin \
; RUN:   -verify-machineinstrs < %s | FileCheck %s

; 20/F054 (B157 C1): llvm.vector.reduce.add on the PULP packed types. VECREDUCE_ADD is Legal
; for v2i16 and v4i8, and used to fail with "Cannot select: vecreduce_add". It is selected to a
; dot product with a splat of 1 (pv.dotsp.sci.h/.b ..., 1): the low 16 (8) bits are the
; wrapped lane sum, the upper bits of a VECREDUCE_ADD result are unspecified.

define i16 @red_v2i16(<2 x i16> %a) nounwind {
; CHECK-LABEL: red_v2i16:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pv.dotsp.sci.h a0, a0, 1
; CHECK-NEXT:    ret
  %r = call i16 @llvm.vector.reduce.add.v2i16(<2 x i16> %a)
  ret i16 %r
}

define i8 @red_v4i8(<4 x i8> %a) nounwind {
; CHECK-LABEL: red_v4i8:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pv.dotsp.sci.b a0, a0, 1
; CHECK-NEXT:    ret
  %r = call i8 @llvm.vector.reduce.add.v4i8(<4 x i8> %a)
  ret i8 %r
}

; The narrow sum is sign-extended from bit 15 (7), not taken as the 32-bit dot product.
define i32 @red_v2i16_sext(<2 x i16> %a) nounwind {
; CHECK-LABEL: red_v2i16_sext:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pv.dotsp.sci.h a0, a0, 1
; CHECK-NEXT:    p.exths a0, a0
; CHECK-NEXT:    ret
  %r = call i16 @llvm.vector.reduce.add.v2i16(<2 x i16> %a)
  %x = sext i16 %r to i32
  ret i32 %x
}

define i32 @red_v4i8_zext(<4 x i8> %a) nounwind {
; CHECK-LABEL: red_v4i8_zext:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pv.dotsp.sci.b a0, a0, 1
; CHECK-NEXT:    p.extbz a0, a0
; CHECK-NEXT:    ret
  %r = call i8 @llvm.vector.reduce.add.v4i8(<4 x i8> %a)
  %x = zext i8 %r to i32
  ret i32 %x
}

; Wider vectors are split into packed registers first.
define i16 @red_v4i16(ptr %p) nounwind {
; CHECK-LABEL: red_v4i16:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lw a1, 0(a0)
; CHECK-NEXT:    lw a0, 4(a0)
; CHECK-NEXT:    pv.add.h a0, a1, a0
; CHECK-NEXT:    pv.dotsp.sci.h a0, a0, 1
; CHECK-NEXT:    ret
  %a = load <4 x i16>, ptr %p, align 4
  %r = call i16 @llvm.vector.reduce.add.v4i16(<4 x i16> %a)
  ret i16 %r
}

define i8 @red_v8i8(ptr %p) nounwind {
; CHECK-LABEL: red_v8i8:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lw a1, 0(a0)
; CHECK-NEXT:    lw a0, 4(a0)
; CHECK-NEXT:    pv.add.b a0, a1, a0
; CHECK-NEXT:    pv.dotsp.sci.b a0, a0, 1
; CHECK-NEXT:    ret
  %a = load <8 x i8>, ptr %p, align 4
  %r = call i8 @llvm.vector.reduce.add.v8i8(<8 x i8> %a)
  ret i8 %r
}
