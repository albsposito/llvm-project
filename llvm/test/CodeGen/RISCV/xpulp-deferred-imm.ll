; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 5
; RUN: llc -mtriple=riscv32 -mattr=+xpulpv -verify-machineinstrs < %s \
; RUN:   | FileCheck %s

; Guards 20/F043: clang emits llvm.riscv.pulp.<op>.deferred for a mul/mac
; N/RN or clip/clipu builtin whose immediate is not an integer constant
; expression (GAP9 GCC checks it only after optimisation). Once the operands
; are constants that pass GCC's rules, instruction selection uses the normal
; instruction with the literal immediate (the error cases are in
; xpulp-deferred-imm-errors.ll).

declare i32 @llvm.riscv.pulp.mulsN.deferred(i32, i32, i32)
declare i32 @llvm.riscv.pulp.mulsRN.deferred(i32, i32, i32, i32)
declare i32 @llvm.riscv.pulp.macuN.deferred(i32, i32, i32, i32)
declare i32 @llvm.riscv.pulp.machhsRN.deferred(i32, i32, i32, i32, i32)
declare i32 @llvm.riscv.pulp.clip.deferred(i32, i32, i32)
declare i32 @llvm.riscv.pulp.clipu.deferred(i32, i32, i32)

define i32 @mulsN(i32 %x, i32 %y) {
; CHECK-LABEL: mulsN:
; CHECK:       # %bb.0:
; CHECK-NEXT:    p.mulsn a0, a0, a1, 10
; CHECK-NEXT:    ret
  %r = call i32 @llvm.riscv.pulp.mulsN.deferred(i32 %x, i32 %y, i32 10)
  ret i32 %r
}

define i32 @mulsRN(i32 %x, i32 %y) {
; CHECK-LABEL: mulsRN:
; CHECK:       # %bb.0:
; CHECK-NEXT:    p.mulsrn a0, a0, a1, 3
; CHECK-NEXT:    ret
  %r = call i32 @llvm.riscv.pulp.mulsRN.deferred(i32 %x, i32 %y, i32 3, i32 4)
  ret i32 %r
}

define i32 @macuN(i32 %x, i32 %y, i32 %acc) {
; CHECK-LABEL: macuN:
; CHECK:       # %bb.0:
; CHECK-NEXT:    p.macun a2, a0, a1, 31
; CHECK-NEXT:    mv a0, a2
; CHECK-NEXT:    ret
  %r = call i32 @llvm.riscv.pulp.macuN.deferred(i32 %x, i32 %y, i32 %acc, i32 31)
  ret i32 %r
}

define i32 @machhsRN(i32 %x, i32 %y, i32 %acc) {
; CHECK-LABEL: machhsRN:
; CHECK:       # %bb.0:
; CHECK-NEXT:    p.machhsrn a2, a0, a1, 1
; CHECK-NEXT:    mv a0, a2
; CHECK-NEXT:    ret
  %r = call i32 @llvm.riscv.pulp.machhsRN.deferred(i32 %x, i32 %y, i32 %acc, i32 1, i32 1)
  ret i32 %r
}

define i32 @clip(i32 %x) {
; CHECK-LABEL: clip:
; CHECK:       # %bb.0:
; CHECK-NEXT:    p.clip a0, a0, 8
; CHECK-NEXT:    ret
  %r = call i32 @llvm.riscv.pulp.clip.deferred(i32 %x, i32 -128, i32 127)
  ret i32 %r
}

define i32 @clipu(i32 %x) {
; CHECK-LABEL: clipu:
; CHECK:       # %bb.0:
; CHECK-NEXT:    p.clipu a0, a0, 9
; CHECK-NEXT:    ret
  %r = call i32 @llvm.riscv.pulp.clipu.deferred(i32 %x, i32 0, i32 255)
  ret i32 %r
}
