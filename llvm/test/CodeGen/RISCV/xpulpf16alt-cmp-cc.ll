; CHECK-NEXT:    mv a1, a2
; CHECK-NEXT:  .LBB7_2:
; CHECK-NEXT:    mv a0, a1
; CHECK-NEXT:    ret
  %t = icmp ne i32 %c, 0
  %r = select i1 %t, bfloat %a, bfloat %b
