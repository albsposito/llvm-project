define bfloat @select_fcmp(bfloat %a, bfloat %b) nounwind {
; CHECK-LABEL: select_fcmp:
; CHECK:       # %bb.0:
; CHECK-NEXT:    flt.ah a2, a1, a0
; CHECK-NEXT:    bnez a2, .LBB6_2
; CHECK-NEXT:  # %bb.1:
; CHECK-NEXT:    mv a0, a1
; CHECK-NEXT:  .LBB6_2:
; CHECK-NEXT:    ret
  %c = fcmp ogt bfloat %a, %b
  %r = select i1 %c, bfloat %a, bfloat %b
  ret bfloat %r
}

define bfloat @select_int(i32 %c, bfloat %a, bfloat %b) nounwind {
