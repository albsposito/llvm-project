}

define bfloat @many_args(i32 %a0, i32 %a1, i32 %a2, i32 %a3, i32 %a4,
; CHECK-LABEL: many_args:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lh a0, 4(sp)
; CHECK-NEXT:    lh a1, 0(sp)
; CHECK-NEXT:    fadd.ah a0, a1, a0
; CHECK-NEXT:    ret
                         i32 %a5, i32 %a6, i32 %a7, bfloat %s0,
