declare bfloat @ext(bfloat, bfloat)

define bfloat @call_ext(bfloat %a) nounwind {
; CHECK-LABEL: call_ext:
; CHECK:       # %bb.0:
; CHECK-NEXT:    addi sp, sp, -16
; CHECK-NEXT:    sw ra, 12(sp) # 4-byte Folded Spill
; CHECK-NEXT:    sw s0, 8(sp) # 4-byte Folded Spill
; CHECK-NEXT:    mv s0, a0
; CHECK-NEXT:    lui a1, 4
; CHECK-NEXT:    call ext
; CHECK-NEXT:    fadd.ah a0, a0, s0
; CHECK-NEXT:    lw ra, 12(sp) # 4-byte Folded Reload
; CHECK-NEXT:    lw s0, 8(sp) # 4-byte Folded Reload
; CHECK-NEXT:    addi sp, sp, 16
; CHECK-NEXT:    ret
  %r = call bfloat @ext(bfloat %a, bfloat 2.0)
  %s = fadd bfloat %r, %a
  ret bfloat %s
}

; A bf16 phi across blocks (the B133 reduction shape) needs no conversion.
define bfloat @reduce_max(ptr %p, i32 %n) nounwind {
; CHECK-LABEL: reduce_max:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    li a2, 0
; CHECK-NEXT:  .LBB10_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    p.lhu a3, 2(a0!)
; CHECK-NEXT:    addi a1, a1, -1
; CHECK-NEXT:    fmax.ah a2, a2, a3
; CHECK-NEXT:    bnez a1, .LBB10_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    mv a0, a2
; CHECK-NEXT:    ret
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %m = phi bfloat [ 0xR0000, %entry ], [ %m.next, %loop ]
  %a = getelementptr bfloat, ptr %p, i32 %i
  %x = load bfloat, ptr %a
  %m.next = call bfloat @llvm.maxnum.bf16(bfloat %m, bfloat %x)
  %i.next = add i32 %i, 1
  %done = icmp eq i32 %i.next, %n
  br i1 %done, label %exit, label %loop
exit:
  ret bfloat %m.next
}
