; GAP9 float16alt compares, selects and calling convention (task 20/F053):
; arguments in a0-a7 like a Zhinx half, the 9th and later in 4-byte stack
; slots, as GAP9 GCC.

define i1 @flt(bfloat %a, bfloat %b) nounwind {
; CHECK-LABEL: flt:
; CHECK:       # %bb.0:
; CHECK-NEXT:    flt.ah a0, a0, a1
; CHECK-NEXT:    ret
  %r = fcmp olt bfloat %a, %b
  ret i1 %r
}

