; Guards 20/F044: with Xpulpv2 on RV32, a 32-bit packed vector (<2 x i16>,
; <4 x i8>, <2 x half>, <2 x bfloat>) is accepted as an inline-asm "r"
; operand and result and lives in one GPR, as in GAP9 GCC (the GAP9 SDK's
; vfcvt_h_x / vfcvt_x_h macros). Without Xpulpv2 upstream's rejection
; (0a35211b3488) stays.

; NOPULP: error: couldn't allocate output register for constraint 'r'

define <2 x i16> @v2i16(<2 x i16> %a) {
; CHECK-LABEL: v2i16:
; CHECK:       # %bb.0:
; CHECK-NEXT:    #APP
; CHECK-NEXT:    pv.add.h a0, a0, a0
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    ret
  %r = call <2 x i16> asm "pv.add.h $0, $1, $1", "=r,r"(<2 x i16> %a)
  ret <2 x i16> %r
}

define <4 x i8> @v4i8(<4 x i8> %a) {
; CHECK-LABEL: v4i8:
; CHECK:       # %bb.0:
; CHECK-NEXT:    #APP
; CHECK-NEXT:    pv.add.b a0, a0, a0
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    ret
  %r = call <4 x i8> asm "pv.add.b $0, $1, $1", "=r,r"(<4 x i8> %a)
  ret <4 x i8> %r
}

; The half-precision pairs are taken from and stored to memory, so that only
; the asm operands (not the calling convention) are exercised.
define void @v2i16_to_v2f16(ptr %src, ptr %dst) {
; CHECK-LABEL: v2i16_to_v2f16:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lw a0, 0(a0)
; CHECK-NEXT:    #APP
; CHECK-NEXT:    xor a0, a0, a0
; CHECK-NEXT:    #NO_APP
; CHECK-NEXT:    sw a0, 0(a1)
; CHECK-NEXT:    ret
  %a = load <2 x i16>, ptr %src
  %r = call <2 x half> asm "xor $0, $1, $1", "=r,r"(<2 x i16> %a)
  store <2 x half> %r, ptr %dst
  ret void
}

