# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 5
# RUN: llc -mtriple=riscv32 -mattr=+m,+xpulpv -run-pass=pulp-hwloops \
# RUN:   -verify-machineinstrs -o - %s | FileCheck %s

# Guards 20/F056 (backlog B23). PULPHardwareLoops on loops whose induction
# update is a post-increment STORE (p.sw/p.sh/p.sb, ri and rr forms) and whose
# latch compares the written-back pointer with a loop-invariant end pointer
# (the shape loop strength reduction's terminator folding produces). These
# must become hardware loops with count (end - start) / stride, the store must
# stay, and a store whose bump is not a known constant is not an induction
# update. Before the fix none of them became a hardware loop.

--- |
  define void @sh_ri_k64(ptr %a, i32 %v) {
  entry:
    br label %body
  exit:
    ret void
  body:
    br i1 poison, label %exit, label %body
  }

  define void @sw_rr_k64(ptr %a, i32 %v) {
  entry:
    br label %body
  exit:
    ret void
  body:
    br i1 poison, label %exit, label %body
  }

  define void @sb_down100(ptr %a, i32 %v) {
  entry:
    br label %body
  exit:
    ret void
  body:
    br i1 poison, label %exit, label %body
  }

  define void @sw_rr_var(ptr %a, i32 %v) {
  entry:
    br label %body
  exit:
    ret void
  body:
    br i1 poison, label %exit, label %body
  }

  define void @end_add(ptr %a, i32 %v, i32 %n) {
  entry:
    br label %ph
  exit:
    ret void
  body:
    br i1 poison, label %exit, label %body
  ph:
    br label %body
  }
...
---
# p.sh, end = start + 128, stride 2: hardware loop, count (end - start) >> 1
name:            sh_ri_k64
tracksRegLiveness: true
liveins:
  - { reg: '$x10', virtual-reg: '%7' }
  - { reg: '$x11', virtual-reg: '%8' }
  - { reg: '$x12' }
body:             |
  ; CHECK-LABEL: name: sh_ri_k64
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $x10, $x11, $x12
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr = COPY $x10
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr = COPY $x11
  ; CHECK-NEXT:   [[ADDI:%[0-9]+]]:gpr = ADDI [[COPY]], 128
  ; CHECK-NEXT:   [[SUB:%[0-9]+]]:gpr = SUB [[ADDI]], [[COPY]]
  ; CHECK-NEXT:   [[SRLI:%[0-9]+]]:gpr = SRLI [[SUB]], 1
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gpr = COPY [[SRLI]]
  ; CHECK-NEXT:   LOOP0setup %bb.2, [[COPY2]]
  ; CHECK-NEXT:   PseudoBR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.exit:
  ; CHECK-NEXT:   PseudoRET
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.body (machine-block-address-taken):
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gpr = PHI [[COPY]], %bb.0, %4, %bb.2
  ; CHECK-NEXT:   [[P_SH_ri_PostIncrement:%[0-9]+]]:gpr = P_SH_ri_PostIncrement [[COPY1]], [[PHI]], 2
  ; CHECK-NEXT:   BEQ [[P_SH_ri_PostIncrement]], [[ADDI]], %bb.1
  ; CHECK-NEXT:   PseudoBR %bb.2
  bb.0.entry:
    successors: %bb.2
    liveins: $x10, $x11, $x12

    %7:gpr = COPY $x10
    %8:gpr = COPY $x11
    %0:gpr = ADDI %7, 128
    PseudoBR %bb.2

  bb.1.exit:
    PseudoRET

  bb.2.body:
    successors: %bb.1, %bb.2

    %3:gpr = PHI %7, %bb.0, %4, %bb.2
    %4:gpr = P_SH_ri_PostIncrement %8, %3, 2
    BEQ %4, %0, %bb.1
    PseudoBR %bb.2
...
