# end = start + (n << 2) behind an n == 0 guard (k12 copy_loop): count (end - start) >> 2
name:            end_add
tracksRegLiveness: true
liveins:
  - { reg: '$x10', virtual-reg: '%7' }
  - { reg: '$x11', virtual-reg: '%8' }
  - { reg: '$x12', virtual-reg: '%9' }
body:             |
  ; CHECK-LABEL: name: end_add
  ; CHECK: bb.0.entry:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.3(0x40000000)
  ; CHECK-NEXT:   liveins: $x10, $x11, $x12
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[COPY:%[0-9]+]]:gpr = COPY $x12
  ; CHECK-NEXT:   [[COPY1:%[0-9]+]]:gpr = COPY $x11
  ; CHECK-NEXT:   [[COPY2:%[0-9]+]]:gpr = COPY $x10
  ; CHECK-NEXT:   BEQ [[COPY]], $x0, %bb.1
  ; CHECK-NEXT:   PseudoBR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1.exit:
  ; CHECK-NEXT:   PseudoRET
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2.body (machine-block-address-taken):
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[PHI:%[0-9]+]]:gpr = PHI [[COPY2]], %bb.3, %4, %bb.2
  ; CHECK-NEXT:   [[P_SW_ri_PostIncrement:%[0-9]+]]:gpr = P_SW_ri_PostIncrement [[COPY1]], [[PHI]], 4
  ; CHECK-NEXT:   BEQ [[P_SW_ri_PostIncrement]], %5, %bb.1
  ; CHECK-NEXT:   PseudoBR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3.ph:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   [[SLLI:%[0-9]+]]:gpr = SLLI [[COPY]], 2
  ; CHECK-NEXT:   [[ADD:%[0-9]+]]:gpr = ADD [[COPY2]], killed [[SLLI]]
  ; CHECK-NEXT:   [[SUB:%[0-9]+]]:gpr = SUB [[ADD]], [[COPY2]]
  ; CHECK-NEXT:   [[SRLI:%[0-9]+]]:gpr = SRLI [[SUB]], 2
  ; CHECK-NEXT:   [[COPY3:%[0-9]+]]:gpr = COPY [[SRLI]]
  ; CHECK-NEXT:   LOOP0setup %bb.2, [[COPY3]]
  ; CHECK-NEXT:   PseudoBR %bb.2
  bb.0.entry:
    successors: %bb.1, %bb.3
    liveins: $x10, $x11, $x12

    %9:gpr = COPY $x12
    %8:gpr = COPY $x11
    %7:gpr = COPY $x10
    BEQ %9, $x0, %bb.1
    PseudoBR %bb.3

  bb.1.exit:
    PseudoRET

  bb.2.body:
    successors: %bb.1, %bb.2

    %3:gpr = PHI %7, %bb.3, %4, %bb.2
    %4:gpr = P_SW_ri_PostIncrement %8, %3, 4
    BEQ %4, %0, %bb.1
    PseudoBR %bb.2

  bb.3.ph:
    successors: %bb.2

    %10:gpr = SLLI %9, 2
    %0:gpr = ADD %7, killed %10
    PseudoBR %bb.2
...
