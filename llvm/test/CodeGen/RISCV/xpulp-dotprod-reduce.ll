; ---- scalar operand: .sc and .sci ----

define i32 @dot_sc_v2i16_acc(<2 x i16> %a, i16 signext %k, i32 %acc) nounwind {
; CHECK-LABEL: dot_sc_v2i16_acc:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pv.sdotsp.sc.h a2, a0, a1
; CHECK-NEXT:    mv a0, a2
; CHECK-NEXT:    ret
  %ea = sext <2 x i16> %a to <2 x i32>
  %ek = sext i16 %k to i32
  %ins = insertelement <2 x i32> poison, i32 %ek, i64 0
