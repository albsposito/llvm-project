; 20/F057 (backlog B156 list B): llvm.vector.reduce.add of extended multiplies and of
; extensions of the PULP packed types (what the loop vectorizer's in-loop reductions emit)
; becomes one dot-product instruction per packed register: pv.dotsp (signed x signed),
; pv.dotup (unsigned x unsigned), pv.dotusp (unsigned x signed, the unsigned operand first),
; their accumulating pv.sdot* forms, the .sc form for a scalar operand and the .sci form for
; a small constant (a sum is a dot product with 1). Cases that do not keep the IR's exact
; value (a value-changing extension around the multiply, a scalar that does not fit the lane,
; a 64-bit result) must not use a dot product.

define i32 @dot_ss_v2i16(<2 x i16> %a, <2 x i16> %b) nounwind {
; CHECK-LABEL: dot_ss_v2i16:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pv.dotsp.h a0, a0, a1
; CHECK-NEXT:    ret
  %ea = sext <2 x i16> %a to <2 x i32>
  %eb = sext <2 x i16> %b to <2 x i32>
  %m = mul nsw <2 x i32> %ea, %eb
  %r = call i32 @llvm.vector.reduce.add.v2i32(<2 x i32> %m)
  ret i32 %r
}

define i32 @dot_ss_v2i16_acc(<2 x i16> %a, <2 x i16> %b, i32 %acc) nounwind {
; CHECK-LABEL: dot_ss_v2i16_acc:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pv.sdotsp.h a2, a0, a1
; CHECK-NEXT:    mv a0, a2
; CHECK-NEXT:    ret
  %ea = sext <2 x i16> %a to <2 x i32>
  %eb = sext <2 x i16> %b to <2 x i32>
  %m = mul nsw <2 x i32> %ea, %eb
  %r = call i32 @llvm.vector.reduce.add.v2i32(<2 x i32> %m)
  %s = add i32 %r, %acc
  ret i32 %s
}

