; ---- sums of absolute differences: |a - b| = max - min in the lanes, then pv.sdotup.sci ----

define i32 @sad_u_v4i8_acc(<4 x i8> %a, <4 x i8> %b, i32 %acc) nounwind {
; CHECK-LABEL: sad_u_v4i8_acc:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pv.minu.b a3, a0, a1
; CHECK-NEXT:    pv.maxu.b a0, a0, a1
; CHECK-NEXT:    pv.sub.b a0, a0, a3
; CHECK-NEXT:    pv.sdotup.sci.b a2, a0, 1
; CHECK-NEXT:    mv a0, a2
; CHECK-NEXT:    ret
  %ea = zext <4 x i8> %a to <4 x i32>
  %eb = zext <4 x i8> %b to <4 x i32>
  %d = sub nsw <4 x i32> %ea, %eb
  %abs = call <4 x i32> @llvm.abs.v4i32(<4 x i32> %d, i1 true)
  %r = call i32 @llvm.vector.reduce.add.v4i32(<4 x i32> %abs)
  %s = add i32 %r, %acc
  ret i32 %s
}

define i32 @sad_s_v2i16_acc(<2 x i16> %a, <2 x i16> %b, i32 %acc) nounwind {
; CHECK-LABEL: sad_s_v2i16_acc:
; CHECK:       # %bb.0:
; CHECK-NEXT:    pv.min.h a3, a0, a1
; CHECK-NEXT:    pv.max.h a0, a0, a1
; CHECK-NEXT:    pv.sub.h a0, a0, a3
; CHECK-NEXT:    pv.sdotup.sci.h a2, a0, 1
; CHECK-NEXT:    mv a0, a2
; CHECK-NEXT:    ret
  %ea = sext <2 x i16> %a to <2 x i32>
  %eb = sext <2 x i16> %b to <2 x i32>
  %d = sub nsw <2 x i32> %ea, %eb
  %abs = call <2 x i32> @llvm.abs.v2i32(<2 x i32> %d, i1 true)
  %r = call i32 @llvm.vector.reduce.add.v2i32(<2 x i32> %abs)
  %s = add i32 %r, %acc
  ret i32 %s
}

; ---- in a loop: the splat of the scalar is built before the loop (as the loop vectorizer
; does) and sunk next to the multiply (RISCVTTIImpl::isProfitableToSinkOperands), so the loop
; body is the .sc form ----

define i32 @dot_sc_loop(ptr %a, i16 signext %k, i32 %n) nounwind {
; CHECK-LABEL: dot_sc_loop:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    li a4, 0
; CHECK-NEXT:    addi a3, a2, -1
; CHECK-NEXT:    li a5, 2
; CHECK-NEXT:    srli a3, a3, 1
; CHECK-NEXT:    sltu a5, a5, a2
; CHECK-NEXT:    neg a5, a5
; CHECK-NEXT:    and a3, a3, a5
; CHECK-NEXT:    addi a5, a3, 1
; CHECK-NEXT:    li a3, 0
; CHECK-NEXT:    .p2align 2
; CHECK-NEXT:  # %bb.4: # %entry
; CHECK-NEXT:    lp.setup x0, a5, .LBB32_3
; CHECK-NEXT:  .LBB32_1: # Block address taken
; CHECK-NEXT:    # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    # Label of block must be emitted
; CHECK-NEXT:    p.lw a5, 4(a0!)
; CHECK-NEXT:  .LBB32_3: # in Loop: Header=BB32_1 Depth=1
; CHECK-NEXT:    # Label of block must be emitted
; CHECK-NEXT:    pv.sdotsp.sc.h a3, a5, a1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    mv a0, a3
; CHECK-NEXT:    ret
; CHECK-NEXT:  .Ltmp0: # Address of block that was removed by CodeGen
entry:
  %ek = sext i16 %k to i32
  %ins = insertelement <2 x i32> poison, i32 %ek, i64 0
  %splat = shufflevector <2 x i32> %ins, <2 x i32> poison, <2 x i32> zeroinitializer
  br label %loop

loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %acc = phi i32 [ 0, %entry ], [ %acc.next, %loop ]
  %p = getelementptr inbounds i16, ptr %a, i32 %i
  %v = load <2 x i16>, ptr %p, align 4
  %ev = sext <2 x i16> %v to <2 x i32>
  %m = mul nsw <2 x i32> %ev, %splat
  %r = call i32 @llvm.vector.reduce.add.v2i32(<2 x i32> %m)
  %acc.next = add i32 %r, %acc
  %i.next = add nuw i32 %i, 2
  %c = icmp ult i32 %i.next, %n
  br i1 %c, label %loop, label %exit

exit:
  ret i32 %acc.next
}
