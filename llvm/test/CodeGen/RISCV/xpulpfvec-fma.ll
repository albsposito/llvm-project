; Dot-product loop: the accumulator stays in one register.
define <2 x half> @dot_h(ptr %x, ptr %w, i32 %n) {
; CHECK-LABEL: dot_h:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    blez a2, .LBB10_4
; CHECK-NEXT:  # %bb.1: # %loop.preheader
; CHECK-NEXT:    slli a2, a2, 2
; CHECK-NEXT:    add a3, a1, a2
; CHECK-NEXT:    sub a2, a3, a1
; CHECK-NEXT:    srli a4, a2, 2
; CHECK-NEXT:    li a2, 0
; CHECK-NEXT:    .p2align 2
; CHECK-NEXT:  # %bb.6: # %loop.preheader
; CHECK-NEXT:    lp.setup x0, a4, .LBB10_5
; CHECK-NEXT:  .LBB10_2: # Block address taken
; CHECK-NEXT:    # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    # Label of block must be emitted
; CHECK-NEXT:    p.lw a4, 4(a0!)
; CHECK-NEXT:    p.lw a5, 4(a1!)
; CHECK-NEXT:  .LBB10_5: # in Loop: Header=BB10_2 Depth=1
; CHECK-NEXT:    # Label of block must be emitted
; CHECK-NEXT:    vfmac.h a2, a4, a5
; CHECK-NEXT:  # %bb.3: # %exit
; CHECK-NEXT:    mv a0, a2
; CHECK-NEXT:    ret
; CHECK-NEXT:  .LBB10_4:
; CHECK-NEXT:    li a0, 0
; CHECK-NEXT:    ret
; CHECK-NEXT:  .Ltmp0: # Address of block that was removed by CodeGen
entry:
  %cmp = icmp sgt i32 %n, 0
  br i1 %cmp, label %loop, label %exit
loop:
  %i = phi i32 [ 0, %entry ], [ %inc, %loop ]
  %acc = phi <2 x half> [ zeroinitializer, %entry ], [ %acc.next, %loop ]
  %px = getelementptr inbounds <2 x half>, ptr %x, i32 %i
  %pw = getelementptr inbounds <2 x half>, ptr %w, i32 %i
  %vx = load <2 x half>, ptr %px, align 4
  %vw = load <2 x half>, ptr %pw, align 4
  %acc.next = call <2 x half> @llvm.fmuladd.v2f16(<2 x half> %vx, <2 x half> %vw, <2 x half> %acc)
  %inc = add nuw nsw i32 %i, 1
  %done = icmp eq i32 %inc, %n
  br i1 %done, label %exit, label %loop
exit:
  %r = phi <2 x half> [ zeroinitializer, %entry ], [ %acc.next, %loop ]
  ret <2 x half> %r
}

