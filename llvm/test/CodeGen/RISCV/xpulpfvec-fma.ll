; a*b - c with c passed as i32 (clang's v2h ABI): still vfmre.
define i32 @fmsub_i32abi_h(i32 %a, i32 %b, i32 %c) {
; CHECK-LABEL: fmsub_i32abi_h:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vfmre.h a2, a0, a1
; CHECK-NEXT:    mv a0, a2
; CHECK-NEXT:    ret
