; A packed bfloat16 maximum carried around a loop (pooling-kernel shape).
define i32 @f16altmax2_loop(ptr %p, i32 %n) {
; CHECK-LABEL: f16altmax2_loop:
; CHECK:       # %bb.0: # %entry
; CHECK-NEXT:    lui a2, 1046544
; CHECK-NEXT:    addi a2, a2, -128
; CHECK-NEXT:  .LBB14_1: # %loop
; CHECK-NEXT:    # =>This Inner Loop Header: Depth=1
; CHECK-NEXT:    p.lw a3, 4(a0!)
; CHECK-NEXT:    p.bclr a4, a2, 15, 0
; CHECK-NEXT:    slli a2, a2, 16
; CHECK-NEXT:    p.bclr a5, a3, 15, 0
; CHECK-NEXT:    slli a3, a3, 16
; CHECK-NEXT:    fmax.s a4, a4, a5
; CHECK-NEXT:    fmax.s a2, a2, a3
; CHECK-NEXT:    p.bclr a3, a4, 15, 0
; CHECK-NEXT:    srli a2, a2, 16
; CHECK-NEXT:    addi a1, a1, -1
; CHECK-NEXT:    or a2, a2, a3
; CHECK-NEXT:    bnez a1, .LBB14_1
; CHECK-NEXT:  # %bb.2: # %exit
; CHECK-NEXT:    mv a0, a2
; CHECK-NEXT:    ret
entry:
  br label %loop
loop:
  %i = phi i32 [ 0, %entry ], [ %i.next, %loop ]
  %acc = phi i32 [ -8323200, %entry ], [ %m, %loop ]
  %addr = getelementptr i32, ptr %p, i32 %i
  %v = load i32, ptr %addr
  %m = call i32 @llvm.riscv.pulp.f16altmax2(i32 %acc, i32 %v)
  %i.next = add i32 %i, 1
  %done = icmp eq i32 %i.next, %n
  br i1 %done, label %exit, label %loop
exit:
  ret i32 %m
}
