# Shared configuration, sourced by every script. Paths are absolute on purpose:
# the build container bind-mounts PORT_ROOT at the same path.
PORT_ROOT=/home/ubuntu/llvm-project/pulp-llvm-port
# Main clone (never built in directly). On this host the harness lives inside the
# owner's fork checkout, so that checkout is the main clone.
LLVM_SRC=/home/ubuntu/llvm-project
WT_ROOT=$PORT_ROOT/wt                     # one git worktree per integration branch or worker
BUILD_ROOT=$PORT_ROOT/build               # one build dir per worktree, same name
LOG_ROOT=$PORT_ROOT/logs
CCACHE_DIR=$PORT_ROOT/ccache
# Empty: build natively (host is Ubuntu 24.04 with the builder image's toolchain
# installed, 2026-09-24). Set to pulp-llvm-builder:1 to build in the container.
BUILDER_IMAGE=

# Host has 32 cores / 123 GB RAM / ~478 GB free (checked 2026-09-24).
# MAX_WORKERS concurrent worker builds at JOBS_PER_BUILD each; the integration
# build uses JOBS_INTEGRATION. Lower these if resource_status reports tight.
MAX_WORKERS=4
JOBS_PER_BUILD=8
JOBS_INTEGRATION=24

# Fork identity (verified via GitHub compare API 2026-09-24).
PULP_18_BRANCH=integer_SIMD_fix
PULP_18_HEAD=6547028f925c4f27f5ff2ae40c3e901bacf886e4
PULP_18_MERGE_BASE=e6c3289804a67ea0bb6a86fadbe454dd93b8d855
PULP_22_BRANCH=llvmorg-22.1.7-pulp

# Lit suite that defines "green" at every step. Paths are relative to the worktree.
LIT_PATHS="llvm/test/CodeGen/RISCV llvm/test/MC/RISCV clang/test/CodeGen/RISCV clang/test/Driver/riscv-arch.c clang/test/Preprocessor/riscv-nofdiv.c clang/test/Misc/target-invalid-cpu-note"
