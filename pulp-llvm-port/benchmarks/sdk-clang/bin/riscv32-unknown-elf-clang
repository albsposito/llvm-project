#!/usr/bin/env python3
"""GCC-compatible driver wrapper that makes the GAP9 SDK build with our clang.

The SDK's CMake (utils/cmake/gcc_flags.cmake, macros.cmake:setupcrosscompile)
calls one program, GAP_RISCV_CC, for C, assembler-with-cpp and the final link,
and passes GAP9 GCC 7 options.  This wrapper:

  * drops GCC-only options clang does not know (-march=rv32imcxgap9, -mPE=N,
    -mFC=N, -mint64, -fno-tree-loop-distribute-patterns, ...), and adds our
    target options (--target, -march=rv32imc_zfinx_xpulpv2, -mabi, -mno-relax);
  * adds the GAP newlib headers (GCC finds them in its sysroot, clang does not);
  * adds the macros GAP9 GCC predefines (-D__gap9__ ...), until task F017 lands;
  * optionally force-includes gap9_clang_compat.h (GAP_CLANG_COMPAT=1), which
    supplies SDK-used builtins our clang lacks (until F016 lands);
  * links with ld.lld (default) or GNU ld of the GAP toolchain
    (GAP_CLANG_LINKER=gnu), with the GAP9 multilib libgcc.a;
  * optionally hands .S files to GAP9 GCC (GAP_CLANG_AS=gnu) instead of clang's
    integrated assembler.

Environment:
  GAP_CLANG_ROOT     dir holding bin/clang, bin/ld.lld (default: snapshot next
                     to this script's work dir, see ../README in report.md)
  GAP_GCC_TC         GAP9 GCC toolchain (default /home/ubuntu/gap_riscv_toolchain_ubuntu)
  GAP_CLANG_LINKER   lld (default) | gnu
  GAP_CLANG_AS       clang (default) | gnu
  GAP_CLANG_COMPAT   1 = force-include gap9_clang_compat.h
  GAP_CLANG_LENIENT  1 = turn clang-only default errors back into warnings
                     (implicit-function-declaration, int-conversion, ...)
  GAP_CLANG_FP16PROBE 1 = probe only: float16=_Float16 (+zhinx), float16alt=__bf16
  GAP_CLANG_EXTRA    extra options appended to every compile
  GAP_CLANG_LOG      file to append every translated command line to
"""
import os, shlex, subprocess, sys

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.environ.get('GAP_CLANG_ROOT') or os.path.join(HERE, '..', 'snap')
GCC_TC = os.environ.get('GAP_GCC_TC', '/home/ubuntu/gap_riscv_toolchain_ubuntu')
CLANG = os.path.join(ROOT, 'bin', 'clang')
GCC = os.path.join(GCC_TC, 'bin', 'riscv32-unknown-elf-gcc')
GNU_LD = os.path.join(GCC_TC, 'bin', 'riscv32-unknown-elf-ld')
LIBGCC_DIR = os.path.join(GCC_TC, 'lib/gcc/riscv32-unknown-elf/7.1.1/rv32imcxgap9/ilp32')
NEWLIB_INC = os.path.join(GCC_TC, 'riscv32-unknown-elf/include')
COMPAT_H = os.path.join(HERE, '..', 'gap9_clang_compat.h')

TARGET = ['--target=riscv32-unknown-elf', '-march=rv32imc_zfinx_xpulpv2',
          '-mabi=ilp32', '-mno-relax']
DEFS = ['-D__gap9__', '-D__pulp__', '-D__pulp', '-D_pulp', '-D__riscv__', '-D_riscv']
# clang warns (and -Werror makes it fatal) about GCC options it merely ignores.
QUIET = ['-Wno-unknown-warning-option', '-Wno-ignored-optimization-argument',
         '-Wno-unused-command-line-argument']
LENIENT = ['-Wno-error=implicit-function-declaration', '-Wno-error=implicit-int',
           '-Wno-error=int-conversion', '-Wno-error=incompatible-pointer-types',
           '-Wno-error=incompatible-function-pointer-types', '-Wno-error=return-type',
           '-Wno-error=int-to-pointer-cast', '-Wno-error=pointer-to-int-cast']

# GCC-only options: dropped (with the given number of following args).
DROP = {'-mint64': 0, '-fno-tree-loop-distribute-patterns': 0, '-flto': 0,
        '-mno-memcpy': 0, '-gstrict-dwarf': 0}
DROP_PREFIX = ('-march=', '-mPE=', '-mFC=', '-mabi=', '-mcpu=', '-mtune=')


def log(cmd):
    p = os.environ.get('GAP_CLANG_LOG')
    if p:
        with open(p, 'a') as f:
            f.write(' '.join(shlex.quote(x) for x in cmd) + '\n')


def main(argv):
    args = argv[1:]
    if not args:
        return subprocess.call([CLANG] + TARGET + ['--version'])
    # Queries CMake or the SDK may issue.
    if args[0] in ('--version', '-v', '-dumpversion', '-dumpmachine'):
        return subprocess.call([CLANG] + TARGET + args)
    if any(a.startswith('-print-') for a in args):
        if '-print-libgcc-file-name' in args:
            print(os.path.join(LIBGCC_DIR, 'libgcc.a'))
            return 0
        return subprocess.call([GCC] + args)

    pe = None
    compile_only = any(a in ('-c', '-S', '-E', '-M', '-MM') for a in args)
    out, i = [], 0
    is_asm = False
    xlang = None
    while i < len(args):
        a = args[i]
        if a in DROP:
            i += 1 + DROP[a]
            continue
        if a.startswith('-mPE='):
            pe = a[5:]
        if a.startswith(DROP_PREFIX):
            i += 1
            continue
        if a == '-x' and i + 1 < len(args):
            xlang = args[i + 1]
        if not compile_only and a in ('-MD', '-MP'):
            i += 1
            continue
        if not compile_only and a == '-MT':
            # The SDK passes a bare "-MT" in its link flags (gcc_flags.cmake);
            # GCC ignores it at link time.  Drop it; its "argument" is the
            # next option, which is kept.
            i += 1
            continue
        if a.endswith(('.S', '.s', '.sx')) and not a.startswith('-'):
            is_asm = True
        out.append(a)
        i += 1
    if xlang and xlang.startswith('assembler'):
        is_asm = True

    if compile_only and is_asm and os.environ.get('GAP_CLANG_AS') == 'gnu':
        cmd = [GCC] + [a for a in args]
        log(cmd)
        return subprocess.call(cmd)

    target = TARGET
    if os.environ.get('GAP_CLANG_FP16PROBE') == '1':
        target = [t.replace('_xpulpv2', '_zhinx_xpulpv2') for t in TARGET]
    cmd = [CLANG] + target + DEFS + QUIET + ['-isystem', NEWLIB_INC]
    if compile_only:
        if os.environ.get('GAP_CLANG_COMPAT') == '1' and not is_asm:
            if pe:
                cmd += ['-D__GAP9_CLANG_PE__=' + pe]
            if os.environ.get('GAP_CLANG_FP16PROBE') == '1':
                cmd += ['-D__GAP9_CLANG_FP16PROBE__']
            cmd += ['-include', os.path.abspath(COMPAT_H)]
        if os.environ.get('GAP_CLANG_LENIENT') == '1':
            cmd += LENIENT
        cmd += shlex.split(os.environ.get('GAP_CLANG_EXTRA', ''))
        cmd += out
    else:
        linker = os.environ.get('GAP_CLANG_LINKER', 'lld')
        if linker == 'gnu':
            cmd += ['--ld-path=' + GNU_LD]
        else:
            # The GAP9 linker scripts place .data_tiny_fc (FC view, L2_priv0
            # aliased at 0x4) and .data_tiny_l1 (cluster view, L1 aliased at
            # 0x4) at the same VMA on purpose: each core sees its own memory
            # there.  GNU ld does not check VMA overlap, lld does.
            cmd += ['-fuse-ld=lld', '-Wl,--no-check-sections']
        cmd += ['-L' + LIBGCC_DIR] + out
    log(cmd)
    return subprocess.call(cmd)


if __name__ == '__main__':
    sys.exit(main(sys.argv))
